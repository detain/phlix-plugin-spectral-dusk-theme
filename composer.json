{
    "name": "detain/phlix-plugin-spectral-dusk-theme",
    "description": "Spectral Dusk UI theme for Phlix — a bioluminescent teal-cyan aesthetic",
    "type": "phlix-plugin",
    "license": "MIT",
    "homepage": "https://github.com/detain/phlix-plugin-spectral-dusk-theme",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "detain/phlix-shared": "^0.21",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Phlix\\SpectralDusk\\": "src/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
        "phpcs": "vendor/bin/phpcs --standard=phpcs.xml",
        "test": "vendor/bin/phpunit"
    }
}
